# ==============================================================================
# market-agent Configuration
# ==============================================================================

# Sizing equity basis in USD (REQUIRED).
# The runner will refuse to start without this.
EQUITY_USD=10000

# Base risk per trade as a fraction of equity (0.005 = 0.5% risk per trade)
RISK_PCT=0.005

# Comma-separated Binance USDⓈ-M futures symbols to track
SYMBOLS=SOLUSDT,ETHUSDT,XRPUSDT

# Assumed leverage for liquidation buffer calculation (1-10, hard-capped at 10)
LEVERAGE=5
LIQ_BUFFER_FRAC=0.5

# Execution fee assumptions in basis points
MAKER_BPS=2
TAKER_BPS=5
SLIPPAGE_BPS=2

# Cascade liquidation USD thresholds over 5m window per symbol
# If unset, cascade regime is disabled for that symbol
CASCADE_LIQ_USD_5M_SOLUSDT=1000000
CASCADE_LIQ_USD_5M_ETHUSDT=5000000
CASCADE_LIQ_USD_5M_XRPUSDT=1000000

# Data freshness thresholds in milliseconds
STALE_MARK_MS=5000
STALE_BOOK_MS=15000

# Directory for trade journals, harnesses, and desk state
DATA_DIR=./data

# UI Web Dashboard & Telemetry port (0 disables server)
UI_PORT=3300

# Ollama LLM Settings
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=openbmb/minicpm5-2b
# OLLAMA_THINK=false
OLLAMA_TEMPERATURE=0.2
OLLAMA_TIMEOUT_MS=20000

# Risk Desk Rules (in R units)
DESK_DAILY_LOSS_R=3
DESK_THROTTLE_DD_R=5
DESK_MAX_DD_R=10
DESK_MAX_CONSEC_LOSSES=3
DESK_COOLDOWN_MIN=240
DESK_MAX_POSITIONS=2
DESK_MAX_OPEN_RISK=2

# Learning loop interval in hours (0 disables in-process learning)
LEARN_INTERVAL_H=24

# ------------------------------------------------------------------------------
# paper_exchange Integration (Optional)
# Leave PX_URL unset to use built-in in-memory paper execution.
# ------------------------------------------------------------------------------
# PX_URL=http://localhost:3100
# PAPER_EXCHANGE_API_KEY=your_paper_exchange_api_key_here
# PX_ACCOUNT_PREFIX=market-agent
# PX_FEED=push

# ------------------------------------------------------------------------------
# Binance Feed Overrides (Optional)
# ------------------------------------------------------------------------------
# BINANCE_WS_BASE=wss://fstream.binance.com
# BINANCE_REST_BASE=https://fapi.binance.com
